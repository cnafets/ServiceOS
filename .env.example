APP_NAME="Your New Mechanic Automation"
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./ynm_automation.db

# Shop-Ware details are intentionally placeholders until API documentation is available.
SHOPWARE_MODE=mock
SHOPWARE_BASE_URL=
SHOPWARE_API_TOKEN=
SHOPWARE_AUTH_HEADER_NAME=Authorization
SHOPWARE_AUTH_SCHEME=Bearer
SHOPWARE_CLIENT_ID=
SHOPWARE_CLIENT_SECRET=
SHOPWARE_TIMEOUT_SECONDS=15
SHOPWARE_RETRY_ATTEMPTS=3
SHOPWARE_RETRY_BACKOFF_SECONDS=0.5
SHOPWARE_APPOINTMENT_CREATE_PATH=
SHOPWARE_APPOINTMENT_UPDATE_PATH=
SHOPWARE_APPOINTMENT_CANCEL_PATH=
SHOPWARE_CUSTOMER_SEARCH_PATH=
SHOPWARE_VEHICLE_SEARCH_PATH=
SHOPWARE_REPAIR_ORDER_SEARCH_PATH=
SHOPWARE_APPOINTMENT_ID_FIELD=id
