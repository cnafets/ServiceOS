APP_NAME="Your New Mechanic Automation"
APP_ENV=local
APP_LOCAL_TIMEZONE=America/New_York
LOG_LEVEL=INFO
LOG_FORMAT=text
INTEGRATION_TEST_MODE=false
IDEMPOTENCY_TTL_SECONDS=86400
DATABASE_URL=sqlite:///./ynm_automation.db

# Shop-Ware live mode is used when INTEGRATION_TEST_MODE=false.
# The official OpenAPI uses X-Api-Partner-Id and X-Api-Secret headers.
SHOPWARE_MODE=live
SHOPWARE_BASE_URL=https://api.shop-ware.com
SHOPWARE_API_PARTNER_ID=
SHOPWARE_API_SECRET=
SHOPWARE_TENANT_ID=
SHOPWARE_DEFAULT_SHOP_ID=
SHOPWARE_DEFAULT_STAFF_ID=
SHOPWARE_CLIENT_ID=
SHOPWARE_CLIENT_SECRET=
SHOPWARE_TIMEOUT_SECONDS=15
SHOPWARE_RETRY_ATTEMPTS=3
SHOPWARE_RETRY_BACKOFF_SECONDS=0.5
SHOPWARE_APPOINTMENT_CREATE_PATH=/api/v1/tenants/{tenant_id}/appointments
SHOPWARE_APPOINTMENT_UPDATE_PATH=/api/v1/tenants/{tenant_id}/appointments/{appointment_id}
SHOPWARE_APPOINTMENT_CANCEL_PATH=/api/v1/tenants/{tenant_id}/appointments/{appointment_id}
SHOPWARE_CUSTOMER_SEARCH_PATH=/api/v1/tenants/{tenant_id}/customers
SHOPWARE_CUSTOMER_CREATE_PATH=/api/v1/tenants/{tenant_id}/customers
SHOPWARE_CUSTOMER_DETAIL_PATH=/api/v1/tenants/{tenant_id}/customers/{customer_id}
SHOPWARE_VEHICLE_SEARCH_PATH=/api/v1/tenants/{tenant_id}/vehicles
SHOPWARE_VEHICLE_CREATE_PATH=/api/v1/tenants/{tenant_id}/vehicles
SHOPWARE_VEHICLE_DETAIL_PATH=/api/v1/tenants/{tenant_id}/vehicles/{vehicle_id}
SHOPWARE_REPAIR_ORDER_SEARCH_PATH=/api/v1/tenants/{tenant_id}/repair_orders
SHOPWARE_REPAIR_ORDER_CREATE_PATH=/api/v1/tenants/{tenant_id}/repair_orders
SHOPWARE_REPAIR_ORDER_DETAIL_PATH=/api/v1/tenants/{tenant_id}/repair_orders/{repair_order_id}
SHOPWARE_APPOINTMENT_ID_FIELD=id

# Quo webhook signing secret; configure privately in deployment environment.
QUO_WEBHOOK_SIGNING_SECRET=
